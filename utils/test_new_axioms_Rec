def new_build_axioms(p, x, rule_left_side, rule_right_side, main_op):
        #aplica as ops, e dps gera a equivalencia final
    if main_op == "EQUIV":
        return Equiv(build_axioms_rec(p, x, rule_left_side), build_axioms_rec(p, x, rule_right_side))
    
    elif main_op == "IMPL":
        return Implies(build_axioms_rec(p, x, rule_left_side), build_axioms_rec(p, x, rule_right_side))
    
    else:
        print("TYPO ON MAIN OP")


def build_axioms_rec(p, x, rule):
    op = rule.split("(")[0]
    print(f"operation: {op}")

    if op == "AND":
        # remove "AND(" from start and ")" from end
        inner = rule[4:-1]
        print(f"inside AND, inner: {inner}")
        rule_components = split_top_level(inner)

        return And(build_axioms_rec(p, x, rule_components[0]), build_axioms_rec(p, x, rule_components[1]))

    elif op == "OR":
        # remove "OR(" from start and ")" from end
        inner = rule[3:-1]
        print(f"inside OR, inner: {inner}")

        rule_components = split_top_level(inner)

        return Or(build_axioms_rec(p, x, rule_components[0]), build_axioms_rec(p, x, rule_components[1]))

    elif op == "NOT":
        print(f"inside NOT, rule: {rule}")
        # remove "NOT(" from start and ")" from end
        not_string = rule[4:-1]

        return Not(build_axioms_rec(p, x, not_string))
    
    #the rule string is only concept,
    else:
        if rule not in CLASS_CONSTANTS:
            print(f"{rule} is not CLASS_CONSTANTS")


        target_cnst = CLASS_CONSTANTS[rule]
        print(f"target_cnst {target_cnst}")

        return p(x, target_cnst)


def split_top_level(s):
    parts = []
    current = []
    depth = 0

    for char in s:
        if char == '(':
            depth += 1
        elif char == ')':
            depth -= 1

        if char == ',' and depth == 1:
            parts.append(''.join(current))
            current = []
        else:
            current.append(char)

    parts.append(''.join(current))
    return parts